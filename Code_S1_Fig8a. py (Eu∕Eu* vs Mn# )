import numpy as np
import matplotlib.pyplot as plt
import pandas as pd
from matplotlib.patches import Rectangle

F = np.linspace(1.0, 0.02, 500)
Mn = 0.15 + 0.35 * (1 - F) / 0.85

scenarios = {
    '1.0 wt% H2O (Fluid-poor)':    {'H2O':1.0, 'k_plag':2.5, 'color':'green', 'style':'--'},
    '3.5 wt% H2O (Moderate)':{'H2O':3.5, 'k_plag':4.5, 'color':'#ED7D31', 'style':'--'},
    '6.0 wt% H2O (Fluid-rich)':{'H2O':6.0, 'k_plag':7.0, 'color':'red', 'style':'--'},
}

def calc_eu(F, H2O, k_plag, eu_min=0.01):
    eu = np.exp(-k_plag * (1-F) * (1 + 0.08*H2O))
    return np.maximum(eu_min, eu)

df = pd.read_csv('grt.csv')
chondrite = {'Eu':0.056, 'Sm':0.148, 'Gd':0.199}

df['Mn_mol'] = df['Mn'] / 54.94
df['Fe_mol'] = df['Fe'] / 55.85
#df['Ca_mol'] = df['Ca'] / 40.08
#df['Mg_mol'] = df['Mg'] / 24.31
df['Mn_number'] = df['Mn_mol'] / (df['Mn_mol']+df['Fe_mol'])

df['Eu_N'] = df['Eu'] / chondrite['Eu']
df['Sm_N'] = df['Sm'] / chondrite['Sm']
df['Gd_N'] = df['Gd'] / chondrite['Gd']
df['EuEu_star'] = df['Eu_N'] / np.sqrt(df['Sm_N'] * df['Gd_N'])

df['Y_Ho'] = df['Y'] / df['Ho']
granite   = df[df['Group'] == 'Granite']
pegmatite = df[df['Group'] == 'Pegmatite']
aplite    = df[df['Group'] == 'Aplite']
sw       = df[df['Group'].str.strip().str.lower() == 'sw']
sh       = df[df['Group'].str.strip().str.lower() == 'sh']
ba       = df[df['Group'].str.strip().str.lower() == 'ba']
rm       = df[df['Group'].str.strip().str.lower() == 'rm']
ho       = df[df['Group'].str.strip().str.lower() == 'ho']


fig, ax = plt.subplots(figsize=(12, 9), dpi=300, frameon=False)

for name, p in scenarios.items():
    eu = calc_eu(F, p['H2O'], p['k_plag'])
    ax.plot(Mn, eu, color=p['color'], linestyle=p['style'],
            linewidth=2.2, label=name, zorder=3)

