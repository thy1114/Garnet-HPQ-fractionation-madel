import numpy as np
import matplotlib.pyplot as plt


def mn2f(mn):
    """Mn# 转结晶度 F"""
    return 1 - (mn - 0.15) * 0.85/ 0.35 

def phi(F, Fcrit):
    """流体饱和度 0→1"""
    return np.maximum(0, (Fcrit - F) / Fcrit)

def yho_trajectory(mn, Fcrit, beta, yho0=34, yho_min=23):
    """Y/Ho 轨迹：起始于石榴子石富集区间 ~34"""
    F = mn2f(mn)
    phi_val = phi(F, Fcrit)
    return yho_min + (yho0 - yho_min) * np.exp(-beta * phi_val)


mn = np.linspace(0.15, 0.50, 300)


hpq_Fcrit = [0.25, 0.35]
hpq_beta  = [0.4, 0.9]
hpq_env = []
for Fc in hpq_Fcrit:
    for b in hpq_beta:
        hpq_env.append(yho_trajectory(mn, Fc, b))
hpq_env = np.array(hpq_env)
hpq_min, hpq_max = hpq_env.min(axis=0), hpq_env.max(axis=0)


fr_Fcrit = [0.80, 0.95]
fr_beta  = [6.0, 8.0]
fr_env = []
for Fc in fr_Fcrit:
    for b in fr_beta:
        fr_env.append(yho_trajectory(mn, Fc, b))
fr_env = np.array(fr_env)
fr_min, fr_max = fr_env.min(axis=0), fr_env.max(axis=0)


mod_yho = yho_trajectory(mn, 0.6, 3.5)

fig, axes = plt.subplots(1, 3, figsize=(14, 4.5))

ax = axes[0]
for Fc in [0.25, 0.30, 0.35]:
    ax.plot(mn, yho_trajectory(mn, Fc, 0.6), 'b-', lw=1.5, alpha=0.7, 
            label=f'$F_{{crit}}$={Fc}')
ax.axhline(28, color='gray', ls=':', alpha=0.6, label='Chondritic Y/Ho = 28')
ax.axvline(0.35, color='gray', ls='--', alpha=0.3)
ax.fill_between([0.35, 0.50], [10, 10], [50, 50], color='green', alpha=0.06)
ax.text(0.42, 15, 'High discrimination\nzone', fontsize=9, color='darkgreen', ha='center')
ax.set_xlim(0.15, 0.50)
ax.set_ylim(10, 50)
ax.set_xlabel('Mn#')
ax.set_ylabel('Y/Ho')
ax.set_title('(a) Fluid-poor: $F_{crit}$ variation\n($\\beta$ = 0.6)')
ax.legend(fontsize=7.5, loc='upper right')

ax = axes[1]
for b in [0.4, 0.6, 0.9]:
    ax.plot(mn, yho_trajectory(mn, 0.30, b), 'b-', lw=1.5, alpha=0.7, 
            label=f'$\\beta$={b}')
ax.axhline(28, color='gray', ls=':', alpha=0.6)
ax.axvline(0.35, color='gray', ls='--', alpha=0.3)
ax.fill_between([0.35, 0.50], [10, 10], [50, 50], color='green', alpha=0.06)
ax.text(0.42, 15, 'High discrimination\nzone', fontsize=9, color='darkgreen', ha='center')
ax.set_xlim(0.15, 0.50)
ax.set_ylim(10, 50)
ax.set_xlabel('Mn#')
ax.set_ylabel('Y/Ho')
ax.set_title('(b) Fluid-poor: $\\beta$ variation\n($F_{crit}$ = 0.3)')
ax.legend(fontsize=7.5, loc='upper right')

ax = axes[2]
ax.fill_between(mn, hpq_min, hpq_max, color='blue', alpha=0.18, label='Fluid-poor envelope')
ax.fill_between(mn, fr_min, fr_max, color='red', alpha=0.18, label='Fluid-rich envelope')
ax.plot(mn, mod_yho, 'g--', lw=2, label='Moderate ($F_{crit}$=0.6, $\\beta$=3.5)')
ax.axhline(28, color='gray', ls=':', alpha=0.6, label='Chondritic Y/Ho = 28')
ax.axvline(0.35, color='gray', ls='--', alpha=0.3)
ax.fill_between([0.35, 0.50], [10, 10], [50, 50], color='green', alpha=0.06)
ax.text(0.42, 15, 'High discrimination\nzone', fontsize=9, color='darkgreen', ha='center')
ax.set_xlim(0.15, 0.50)
ax.set_ylim(10, 50)
ax.set_xlabel('Mn#')
ax.set_ylabel('Y/Ho')
ax.set_title('(c) Combined uncertainty envelopes')
ax.legend(fontsize=7.5, loc='upper right')

plt.tight_layout()
plt.show()
